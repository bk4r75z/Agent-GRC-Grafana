# Copier en .env puis adapter.
# Clé API Claude (facultative : sans clé, l'agent utilise une classification
# heuristique et le chatbot répond en mode déterministe, toujours sourcé).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

POSTGRES_PASSWORD=grc
GF_ADMIN_PASSWORD=admin
# Jeton exigé par le serveur MCP de ses clients (le chatbot)
MCP_GRAFANA_SERVER_TOKEN=change-me-mcp-token
GRAFANA_PUBLIC_URL=http://localhost:3000
COLLECT_INTERVAL_MINUTES=60
