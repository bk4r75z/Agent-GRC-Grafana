          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT published_at AS \"Date\", criticity AS \"Criticité\", category AS \"Type\", title AS \"Titre\",\n       summary AS \"Résumé\", recommended_action AS \"Action recommandée\", source_url AS \"Lien\"\nFROM risks WHERE kind = 'reglementaire'\nORDER BY published_at DESC NULLS LAST LIMIT 25"
