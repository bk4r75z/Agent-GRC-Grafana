            "type": "grafana-postgresql-datasource",
            "uid": "grc-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT source AS \"Source\",\n  count(*) FILTER (WHERE criticity = 'critique') AS critique,\n  count(*) FILTER (WHERE criticity = 'élevé') AS \"élevé\",\n  count(*) FILTER (WHERE criticity = 'moyen') AS moyen,\n  count(*) FILTER (WHERE criticity = 'faible') AS faible\nFROM risks GROUP BY source ORDER BY source"
